<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainAcitivity_parameter"
    android:orientation="vertical">

    <ListView
        android:id="@+id/list_test"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="250dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >
       <Button
           android:id="@+id/test_left_45_add_50"
           android:layout_width="0dp"
           android:layout_weight="1"
            android:text="左转45°码盘+50"
            android:layout_height="wrap_content"
           />
        <Button
            android:id="@+id/test_left_45_sub_50"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="左转45°码盘-50"
            android:layout_height="wrap_content"
            />

        <Button
            android:id="@+id/test_xunju_add_5"
            android:layout_width="0dp"
            android:text="循迹+5"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/test_right_45_add_50"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="右转45°码盘+50"
            android:layout_height="wrap_content"
            />
        <Button
            android:id="@+id/test_right_45_sub_50"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="右转45°码盘-50"
            android:layout_height="wrap_content"
            />
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >
        <Button
            android:id="@+id/test_left_45"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="左转45°"
            android:layout_height="wrap_content"
            />

        <Button
            android:id="@+id/test_go_add_100"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="前进+100"
            android:layout_weight="1"
            />

        <Button
            android:id="@+id/test_go"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="前进"
            android:background="@drawable/go"
            android:layout_height="wrap_content"
            />
        <Button
            android:id="@+id/test_go_sub_100"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="前进 -100"
            android:layout_height="wrap_content"
            />
        <Button
            android:id="@+id/test_right_45"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="右转45°"
            android:layout_height="wrap_content"
            />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >
        <Button
            android:id="@+id/test_guaiwan_add_10"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="拐弯角 度+10"
            android:layout_height="wrap_content"
            />
        <Button
            android:id="@+id/test_left"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="左转"
            android:background="@drawable/left"
            android:layout_height="wrap_content"
            />
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            />
        <Button
            android:id="@+id/test_right"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="右转"
            android:background="@drawable/right"
            android:layout_height="wrap_content"
            />
        <Button
            android:id="@+id/test_guaiwan_sub_10"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="拐弯角度-10"
            android:layout_height="wrap_content"
            />
    </LinearLayout>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >
        <Button
            android:id="@+id/test_delay_xunji_add_100"
             android:layout_width="0dp"
             android:layout_weight="1"
            android:text="delay循迹+100"
             android:layout_height="wrap_content"
            />
        <Button
            android:id="@+id/test_back_add_100"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="后退+100"
            android:layout_height="wrap_content"
            />
        <Button
            android:id="@+id/test_back"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:background="@drawable/stop"
            android:text="后退"
            android:layout_height="wrap_content"
            />
         <Button
             android:id="@+id/test_back_sub_100"
            android:layout_width="0dp"
            android:layout_weight="1"
             android:text="后退 -100"
            android:layout_height="wrap_content"
            />
        <Button
            android:id="@+id/test_delay_xunji_sub_100"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="delay循迹-100"
            android:layout_height="wrap_content"
            />
</LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >
        <Button
            android:id="@+id/test_left_add_5"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="左转+5"
            android:layout_height="wrap_content"
            />
        <Button
            android:id="@+id/test_left_sub_5"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="左转-5"
            android:layout_height="wrap_content"
            />
        <Button
            android:id="@+id/test_xunju_sub_5"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="循迹-5"
            android:layout_height="wrap_content"
            />
        <Button
            android:id="@+id/test_right_add_5"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="右转+5"
            android:layout_height="wrap_content"
            />
        <Button
            android:id="@+id/test_right_sub_5"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="右转-5"
            android:layout_height="wrap_content"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >
        <Button
            android:id="@+id/test_xunji"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="循迹"
            android:layout_height="wrap_content"
            />
        <Button
            android:id="@+id/test_delay_xunji"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="delay循迹"
            android:layout_height="wrap_content"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >
        <Button
            android:id="@+id/btn_car"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="小轿车"
            android:layout_height="wrap_content"
            />
        <Button
            android:id="@+id/btn_motor"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="摩托"
            android:layout_height="wrap_content"
            />
        <Button
            android:id="@+id/btn_bicycle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="自行车"
            android:layout_height="wrap_content"
            />
        <Button
            android:id="@+id/btn_big_car"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="货车"
            android:layout_height="wrap_content"
            />
    </LinearLayout>

    <EditText
        android:id="@+id/et_wish"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />
    <Button
        android:id="@+id/btn_wish"
        android:layout_width="70dp"
        android:layout_height="60dp"
        />
</LinearLayout>